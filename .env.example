PBS_URL=https://pbs.example.com:8007
PBS_TOKEN_ID=mcp@pbs!claude
PBS_TOKEN_SECRET=
# true | false | Pfad zu CA-Datei (PBS nutzt oft ein selbstsigniertes Zertifikat)
PBS_VERIFY_SSL=true
# langes zufaelliges Bearer-Token fuer den MCP-Endpoint
MCP_AUTH_TOKEN=
# optional
MCP_BIND_ADDR=127.0.0.1
MCP_HOST_PORT=8423
# true sperrt alle schreibenden Tools (Verify/GC starten, Loeschen)
MCP_READONLY=false
# true erlaubt snapshot_forget (unwiderruflich, zusaetzlich confirm pro Aufruf)
MCP_ALLOW_DELETE=false
